# Environment Variables for Talk Safe Frontend
# Copy this file to .env.local for local development

# Backend API URL
VITE_API_BASE_URL=http://localhost:3000/api

# App Configuration
VITE_APP_NAME="Talk Safe"
VITE_APP_VERSION="1.0.0"

# Emergency Contact Numbers (customizable per region)
VITE_EMERGENCY_NUMBER=911
VITE_POLICE_NUMBER=911
VITE_MEDICAL_NUMBER=911

# Feature Flags
VITE_ENABLE_DARK_MODE=true
VITE_ENABLE_PWA=true
VITE_ENABLE_ANALYTICS=false

# Security Settings
VITE_EVIDENCE_VAULT_PIN=1234
VITE_SESSION_TIMEOUT=3600000

# External Services (for future integration)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
VITE_ANALYTICS_ID=your_analytics_id_here